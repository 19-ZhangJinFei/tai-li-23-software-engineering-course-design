APP_ENV=development
APP_SECRET=change-this-secret-before-production
# Vercel/Supabase: use the Transaction pooler URL (port 6543). Generic
# postgres:// and postgresql:// URLs are normalized to psycopg 3 automatically.
DATABASE_URL=postgresql+psycopg://course_ai:course_ai@postgres:5432/course_ai
FRONTEND_ORIGIN=http://localhost:5173
AUTO_APPROVE_REGISTRATION=true
DEMO_ADMIN_EMAIL=admin@demo.com
DEMO_ADMIN_PASSWORD=Admin@123456
DEMO_STUDENT_EMAIL=student@demo.com
DEMO_STUDENT_PASSWORD=Student@123456
AI_MODE=fake
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CHAT_MODEL=qwen-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
RAG_SIMILARITY_THRESHOLD=0.35
STORAGE_MODE=s3
STORAGE_BUCKET=course-documents
STORAGE_ENDPOINT=http://minio:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1
MAX_UPLOAD_MB=25
